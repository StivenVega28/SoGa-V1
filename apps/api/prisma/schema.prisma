// SoGa · Precision Ledger — Prisma schema
// Dinero = Decimal(12,2). Inventario = kardex (inventory_movements) + stock derivado.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum MovementType {
  ENTRADA
  SALIDA
  AJUSTE
  ANULACION
}

enum SaleStatus {
  BORRADOR
  CONFIRMADA
  ANULADA
}

enum QuoteStatus {
  BORRADOR
  ENVIADA
  ACEPTADA
  RECHAZADA
}

model Role {
  id          Int      @id @default(autoincrement())
  name        String   @unique @db.VarChar(100)
  permissions String   @db.Text
  description String   @db.VarChar(255)
  users       User[]
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("roles")
}

model User {
  id           Int       @id @default(autoincrement())
  roleId       Int       @map("role_id")
  document     String    @unique @db.VarChar(20)
  firstName    String    @map("first_name") @db.VarChar(100)
  lastName     String    @map("last_name") @db.VarChar(100)
  phone        String?   @db.VarChar(20)
  email        String    @unique @db.VarChar(150)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  emailVerified Boolean  @default(false) @map("email_verified")
  deletedAt    DateTime? @map("deleted_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  role         Role      @relation(fields: [roleId], references: [id])

  @@map("users")
}

model Supplier {
  id          Int       @id @default(autoincrement())
  nit         String    @unique @db.VarChar(20)
  name        String    @db.VarChar(150)
  city        String    @db.VarChar(100)
  address     String    @db.VarChar(150)
  phone       String    @db.VarChar(20)
  email       String    @db.VarChar(150)
  description String?   @db.Text
  deletedAt   DateTime? @map("deleted_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  products    Product[]
  purchases   Purchase[]

  @@map("suppliers")
}

model Customer {
  id        Int       @id @default(autoincrement())
  nit       String    @unique @db.VarChar(20)
  firstName String    @map("first_name") @db.VarChar(100)
  lastName  String?   @map("last_name") @db.VarChar(100)
  city      String    @db.VarChar(100)
  branch    String?   @db.VarChar(100)
  address   String    @db.VarChar(150)
  phone     String    @db.VarChar(20)
  email     String    @db.VarChar(150)
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  sales     Sale[]
  quotes    Quote[]

  @@map("customers")
}

model Product {
  id          Int       @id @default(autoincrement())
  supplierId  Int?      @map("supplier_id")
  name        String    @db.VarChar(200)
  description String    @db.Text
  price       Decimal   @db.Decimal(12, 2)
  category    String    @db.VarChar(100)
  image       String?   @db.VarChar(255)
  active      Boolean   @default(true)
  deletedAt   DateTime? @map("deleted_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  supplier    Supplier? @relation(fields: [supplierId], references: [id])
  purchases   Purchase[]
  movements   InventoryMovement[]
  saleItems   SaleItem[]
  quoteItems  QuoteItem[]

  @@map("products")
}

model Purchase {
  id          Int      @id @default(autoincrement())
  supplierId  Int      @map("supplier_id")
  productId   Int      @map("product_id")
  quantity    Int
  unitCost    Decimal  @map("unit_cost") @db.Decimal(12, 2)
  total       Decimal  @db.Decimal(12, 2)
  purchasedAt DateTime @map("purchased_at")
  createdAt   DateTime @default(now()) @map("created_at")
  supplier    Supplier @relation(fields: [supplierId], references: [id])
  product     Product  @relation(fields: [productId], references: [id])

  @@map("purchases")
}

model InventoryMovement {
  id            Int          @id @default(autoincrement())
  productId     Int          @map("product_id")
  type          MovementType
  quantity      Int
  unitCost      Decimal?     @map("unit_cost") @db.Decimal(12, 2)
  referenceType String?      @map("reference_type") @db.VarChar(40)
  referenceId   Int?         @map("reference_id")
  note          String?      @db.VarChar(255)
  occurredAt    DateTime     @map("occurred_at")
  createdAt     DateTime     @default(now()) @map("created_at")
  product       Product      @relation(fields: [productId], references: [id])

  @@index([productId, occurredAt])
  @@map("inventory_movements")
}

model Sale {
  id         Int        @id @default(autoincrement())
  customerId Int        @map("customer_id")
  issuedAt   DateTime   @map("issued_at")
  subtotal   Decimal    @db.Decimal(12, 2)
  tax        Decimal    @db.Decimal(12, 2)
  total      Decimal    @db.Decimal(12, 2)
  status     SaleStatus @default(BORRADOR)
  notes      String?    @db.Text
  deletedAt  DateTime?  @map("deleted_at")
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")
  customer   Customer   @relation(fields: [customerId], references: [id])
  items      SaleItem[]

  @@map("sales")
}

model SaleItem {
  id        Int     @id @default(autoincrement())
  saleId    Int     @map("sale_id")
  productId Int     @map("product_id")
  quantity  Int
  unitPrice Decimal @map("unit_price") @db.Decimal(12, 2)
  lineTotal Decimal @map("line_total") @db.Decimal(12, 2)
  sale      Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])

  @@map("sale_items")
}

model Quote {
  id         Int         @id @default(autoincrement())
  customerId Int         @map("customer_id")
  issuedAt   DateTime    @map("issued_at")
  subtotal   Decimal     @db.Decimal(12, 2)
  tax        Decimal     @db.Decimal(12, 2)
  total      Decimal     @db.Decimal(12, 2)
  status     QuoteStatus @default(BORRADOR)
  deletedAt  DateTime?   @map("deleted_at")
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")
  customer   Customer    @relation(fields: [customerId], references: [id])
  items      QuoteItem[]

  @@map("quotes")
}

model QuoteItem {
  id          Int     @id @default(autoincrement())
  quoteId     Int     @map("quote_id")
  productId   Int     @map("product_id")
  quantity    Int
  unitPrice   Decimal @map("unit_price") @db.Decimal(12, 2)
  lineTotal   Decimal @map("line_total") @db.Decimal(12, 2)
  quote       Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  product     Product @relation(fields: [productId], references: [id])

  @@map("quote_items")
}

model Message {
  id        Int      @id @default(autoincrement())
  firstName String   @map("first_name") @db.VarChar(100)
  lastName  String?  @map("last_name") @db.VarChar(100)
  email     String   @db.VarChar(150)
  phone     String?  @db.VarChar(20)
  subject   String   @db.VarChar(150)
  message   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  @@map("messages")
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  actorId    Int?     @map("actor_id")
  action     String   @db.VarChar(80)
  entity     String   @db.VarChar(80)
  entityId   Int?     @map("entity_id")
  beforeData String?  @map("before_data") @db.Text
  afterData  String?  @map("after_data") @db.Text
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([entity, entityId])
  @@map("audit_logs")
}
