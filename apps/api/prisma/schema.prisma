// SoGa · Precision Ledger — esquema Prisma (nombres de negocio en español)
// Dinero = Decimal(12,2). Inventario = kardex (movimientos_inventario) + stock derivado.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum TipoMovimiento {
  ENTRADA
  SALIDA
  AJUSTE
  ANULACION
}

enum EstadoVenta {
  BORRADOR
  CONFIRMADA
  ANULADA
}

enum EstadoCotizacion {
  BORRADOR
  ENVIADA
  ACEPTADA
  RECHAZADA
}

model Rol {
  id            Int      @id @default(autoincrement())
  nombre        String   @unique @db.VarChar(100)
  permisos      String   @db.Text
  descripcion   String   @db.VarChar(255)
  creadoEn      DateTime @default(now()) @map("creado_en")
  actualizadoEn DateTime @default(now()) @updatedAt @map("actualizado_en")
  usuarios      Usuario[]

  @@map("roles")
}

model Usuario {
  id                String    @id @db.VarChar(36)
  rolId             Int?      @map("rol_id")
  documento         String?   @unique @db.VarChar(20)
  nombre            String    @db.VarChar(150)
  apellido          String?   @db.VarChar(100)
  telefono          String?   @db.VarChar(20)
  correo            String    @unique @db.VarChar(150)
  correoVerificado  Boolean   @default(false) @map("correo_verificado")
  imagen            String?   @db.VarChar(255)
  eliminadoEn       DateTime? @map("eliminado_en")
  creadoEn          DateTime  @default(now()) @map("creado_en")
  actualizadoEn     DateTime  @default(now()) @updatedAt @map("actualizado_en")
  rol               Rol?      @relation(fields: [rolId], references: [id])
  sesiones          Sesion[]
  cuentas           Cuenta[]

  @@index([rolId])
  @@map("usuarios")
}

model Sesion {
  id             String   @id @db.VarChar(36)
  usuarioId      String   @map("usuario_id") @db.VarChar(36)
  token          String   @unique @db.VarChar(255)
  expiraEn       DateTime @map("expira_en")
  ip             String?  @db.VarChar(64)
  agenteUsuario  String?  @map("agente_usuario") @db.VarChar(255)
  creadoEn       DateTime @default(now()) @map("creado_en")
  actualizadoEn  DateTime @default(now()) @updatedAt @map("actualizado_en")
  usuario        Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@map("sesiones")
}

model Cuenta {
  id               String    @id @db.VarChar(36)
  cuentaId         String    @map("cuenta_id") @db.VarChar(255)
  proveedorId      String    @map("proveedor_id") @db.VarChar(80)
  usuarioId        String    @map("usuario_id") @db.VarChar(36)
  tokenAcceso      String?   @map("token_acceso") @db.Text
  tokenRefresco    String?   @map("token_refresco") @db.Text
  tokenId          String?   @map("token_id") @db.Text
  expiraAccesoEn   DateTime? @map("expira_acceso_en")
  expiraRefrescoEn DateTime? @map("expira_refresco_en")
  alcance          String?   @db.Text
  contrasena       String?   @db.Text
  creadoEn         DateTime  @default(now()) @map("creado_en")
  actualizadoEn    DateTime  @default(now()) @updatedAt @map("actualizado_en")
  usuario          Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@map("cuentas")
}

model Verificacion {
  id             String   @id @db.VarChar(36)
  identificador  String   @map("identificador") @db.VarChar(255)
  valor          String   @db.Text
  expiraEn       DateTime @map("expira_en")
  creadoEn       DateTime @default(now()) @map("creado_en")
  actualizadoEn  DateTime @default(now()) @updatedAt @map("actualizado_en")

  @@index([identificador])
  @@map("verificaciones")
}

model Proveedor {
  id            Int       @id @default(autoincrement())
  nit           String    @unique @db.VarChar(20)
  nombre        String    @db.VarChar(150)
  ciudad        String    @db.VarChar(100)
  direccion     String    @db.VarChar(150)
  telefono      String    @db.VarChar(20)
  correo        String    @db.VarChar(150)
  descripcion   String?   @db.Text
  eliminadoEn   DateTime? @map("eliminado_en")
  creadoEn      DateTime  @default(now()) @map("creado_en")
  actualizadoEn DateTime  @default(now()) @updatedAt @map("actualizado_en")
  productos     Producto[]
  compras       Compra[]

  @@map("proveedores")
}

model Cliente {
  id            Int       @id @default(autoincrement())
  nit           String    @unique @db.VarChar(20)
  nombre        String    @db.VarChar(100)
  apellido      String?   @db.VarChar(100)
  ciudad        String    @db.VarChar(100)
  sucursal      String?   @db.VarChar(100)
  direccion     String    @db.VarChar(150)
  telefono      String    @db.VarChar(20)
  correo        String    @db.VarChar(150)
  eliminadoEn   DateTime? @map("eliminado_en")
  creadoEn      DateTime  @default(now()) @map("creado_en")
  actualizadoEn DateTime  @default(now()) @updatedAt @map("actualizado_en")
  ventas        Venta[]
  cotizaciones  Cotizacion[]

  @@map("clientes")
}

model Categoria {
  id            Int        @id @default(autoincrement())
  nombre        String     @unique @db.VarChar(100)
  descripcion   String?    @db.VarChar(255)
  creadoEn      DateTime   @default(now()) @map("creado_en")
  actualizadoEn DateTime   @default(now()) @updatedAt @map("actualizado_en")
  productos     Producto[]

  @@map("categorias")
}

model Producto {
  id             Int       @id @default(autoincrement())
  proveedorId    Int?      @map("proveedor_id")
  categoriaId    Int       @map("categoria_id")
  sku            String    @unique @db.VarChar(40)
  nombre         String    @db.VarChar(200)
  descripcion    String    @db.Text
  precio         Decimal   @db.Decimal(12, 2)
  costo          Decimal   @default(0) @db.Decimal(12, 2)
  unidad         String    @default("UNIDAD") @db.VarChar(20)
  stockMinimo    Int       @default(0) @map("stock_minimo")
  imagen         String?   @db.VarChar(255)
  imagenes       Json?
  destacado      Boolean   @default(false)
  activo         Boolean   @default(true)
  eliminadoEn    DateTime? @map("eliminado_en")
  creadoEn       DateTime  @default(now()) @map("creado_en")
  actualizadoEn  DateTime  @default(now()) @updatedAt @map("actualizado_en")
  proveedor      Proveedor? @relation(fields: [proveedorId], references: [id])
  categoria      Categoria  @relation(fields: [categoriaId], references: [id])
  detallesCompra DetalleCompra[]
  movimientos    MovimientoInventario[]
  variantes      Variante[]
  itemsVenta     DetalleVenta[]
  itemsCotizacion DetalleCotizacion[]

  @@index([proveedorId])
  @@index([categoriaId])
  @@map("productos")
}

model Variante {
  id            Int      @id @default(autoincrement())
  productoId    Int      @map("producto_id")
  sku           String   @unique @db.VarChar(60)
  nombre        String   @db.VarChar(120)
  precio        Decimal? @db.Decimal(12, 2)
  activo        Boolean  @default(true)
  creadoEn      DateTime @default(now()) @map("creado_en")
  actualizadoEn DateTime @default(now()) @updatedAt @map("actualizado_en")
  producto      Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)

  @@index([productoId])
  @@map("variantes")
}

model Compra {
  id          Int             @id @default(autoincrement())
  proveedorId Int             @map("proveedor_id")
  total       Decimal         @db.Decimal(12, 2)
  compradoEn  DateTime        @map("comprado_en")
  creadoEn    DateTime        @default(now()) @map("creado_en")
  proveedor   Proveedor       @relation(fields: [proveedorId], references: [id])
  detalles    DetalleCompra[]

  @@index([proveedorId])
  @@map("compras")
}

model DetalleCompra {
  id            Int     @id @default(autoincrement())
  compraId      Int     @map("compra_id")
  productoId    Int     @map("producto_id")
  cantidad      Int
  costoUnitario Decimal @map("costo_unitario") @db.Decimal(12, 2)
  totalLinea    Decimal @map("total_linea") @db.Decimal(12, 2)
  compra        Compra   @relation(fields: [compraId], references: [id], onDelete: Cascade)
  producto      Producto @relation(fields: [productoId], references: [id])

  @@index([compraId])
  @@index([productoId])
  @@map("detalle_compras")
}

model MovimientoInventario {
  id              Int            @id @default(autoincrement())
  productoId      Int            @map("producto_id")
  tipo            TipoMovimiento
  cantidad        Int
  costoUnitario   Decimal?       @map("costo_unitario") @db.Decimal(12, 2)
  tipoReferencia  String?        @map("tipo_referencia") @db.VarChar(40)
  referenciaId    Int?           @map("referencia_id")
  nota            String?        @db.VarChar(255)
  ocurridoEn      DateTime       @map("ocurrido_en")
  creadoEn        DateTime       @default(now()) @map("creado_en")
  producto        Producto       @relation(fields: [productoId], references: [id])

  @@index([productoId, ocurridoEn])
  @@index([tipoReferencia, referenciaId])
  @@map("movimientos_inventario")
}

model Venta {
  id            Int        @id @default(autoincrement())
  clienteId     Int        @map("cliente_id")
  emitidaEn     DateTime   @map("emitida_en")
  subtotal      Decimal    @db.Decimal(12, 2)
  impuesto      Decimal    @db.Decimal(12, 2)
  total         Decimal    @db.Decimal(12, 2)
  estado        EstadoVenta @default(BORRADOR)
  notas         String?    @db.Text
  eliminadoEn   DateTime?  @map("eliminado_en")
  creadoEn      DateTime   @default(now()) @map("creado_en")
  actualizadoEn DateTime   @default(now()) @updatedAt @map("actualizado_en")
  cliente       Cliente    @relation(fields: [clienteId], references: [id])
  items         DetalleVenta[]

  @@index([clienteId])
  @@map("ventas")
}

model DetalleVenta {
  id             Int     @id @default(autoincrement())
  ventaId        Int     @map("venta_id")
  productoId     Int     @map("producto_id")
  cantidad       Int
  precioUnitario Decimal @map("precio_unitario") @db.Decimal(12, 2)
  totalLinea     Decimal @map("total_linea") @db.Decimal(12, 2)
  venta          Venta   @relation(fields: [ventaId], references: [id], onDelete: Cascade)
  producto       Producto @relation(fields: [productoId], references: [id])

  @@index([ventaId])
  @@index([productoId])
  @@map("detalle_ventas")
}

model Cotizacion {
  id            Int              @id @default(autoincrement())
  clienteId     Int              @map("cliente_id")
  emitidaEn     DateTime         @map("emitida_en")
  subtotal      Decimal          @db.Decimal(12, 2)
  impuesto      Decimal          @db.Decimal(12, 2)
  total         Decimal          @db.Decimal(12, 2)
  estado        EstadoCotizacion @default(BORRADOR)
  eliminadoEn   DateTime?        @map("eliminado_en")
  creadoEn      DateTime         @default(now()) @map("creado_en")
  actualizadoEn DateTime         @default(now()) @updatedAt @map("actualizado_en")
  cliente       Cliente          @relation(fields: [clienteId], references: [id])
  items         DetalleCotizacion[]

  @@index([clienteId])
  @@map("cotizaciones")
}

model DetalleCotizacion {
  id             Int        @id @default(autoincrement())
  cotizacionId   Int        @map("cotizacion_id")
  productoId     Int        @map("producto_id")
  cantidad       Int
  precioUnitario Decimal    @map("precio_unitario") @db.Decimal(12, 2)
  totalLinea     Decimal    @map("total_linea") @db.Decimal(12, 2)
  cotizacion     Cotizacion @relation(fields: [cotizacionId], references: [id], onDelete: Cascade)
  producto       Producto   @relation(fields: [productoId], references: [id])

  @@index([cotizacionId])
  @@index([productoId])
  @@map("detalle_cotizaciones")
}

model Mensaje {
  id       Int      @id @default(autoincrement())
  nombre   String   @db.VarChar(100)
  apellido String?  @db.VarChar(100)
  correo   String   @db.VarChar(150)
  telefono String?  @db.VarChar(20)
  asunto   String   @db.VarChar(150)
  mensaje  String   @db.Text
  creadoEn DateTime @default(now()) @map("creado_en")

  @@map("mensajes")
}

model Auditoria {
  id           Int      @id @default(autoincrement())
  actorId      Int?     @map("actor_id")
  accion       String   @db.VarChar(80)
  entidad      String   @db.VarChar(80)
  entidadId    Int?     @map("entidad_id")
  datosAntes   String?  @map("datos_antes") @db.Text
  datosDespues String?  @map("datos_despues") @db.Text
  creadoEn     DateTime @default(now()) @map("creado_en")

  @@index([entidad, entidadId])
  @@map("auditoria")
}
