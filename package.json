{
  "name": "soga",
  "version": "0.1.0",
  "private": true,
  "description": "SoGa - Soluciones Garantizadas PS S.A.S. ERP/CRM (monorepo)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev -w @soga/web",
    "dev:api": "npm run start:dev -w @soga/api",
    "build": "npm run build -w @soga/api && npm run build -w @soga/web",
    "start:prod": "npm run build && node apps/api/dist/main.js --web",
    "build:web": "npm run build -w @soga/web",
    "build:api": "npm run build -w @soga/api",
    "lint": "npm run lint -w @soga/web",
    "test": "npm run test -w @soga/api",
    "prisma:generate": "npm run prisma:generate -w @soga/api",
    "prisma:deploy": "npm run prisma:deploy -w @soga/api",
    "db:push": "npm run prisma:push -w @soga/api"
  },
  "engines": {
    "node": ">=20.19"
  }
}
